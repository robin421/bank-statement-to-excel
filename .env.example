# Public site origin, no trailing slash. Used for canonicals, sitemap, OG tags.
PUBLIC_SITE_URL=https://example.com

# Cloudflare Web Analytics beacon token (cookieless, no consent banner needed).
# Leave empty to disable analytics entirely.
PUBLIC_CF_ANALYTICS_TOKEN=

# OCR / scanned-PDF affiliate offer. Shown only on the /scanned page and as a
# fallback when a PDF has no usable text layer.
PUBLIC_AFFILIATE_OCR_URL=

# Google AdSense publisher id, e.g. ca-pub-0000000000000000.
# Leave empty until the site is approved; ad slots render nothing when empty.
PUBLIC_ADSENSE_CLIENT=
