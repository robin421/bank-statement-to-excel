node_modules/
dist/
.astro/
.env
.env.local
.DS_Store
._*

# ---------------------------------------------------------------------------
# Never commit bank statements.
#
# These are third-party documents, and several of them are REAL account
# statements — public court exhibits, but publishing them from a repository is a
# different act from reading them in a docket. The blanket rule is the fix for
# the actual root cause here: `corpus/court/` was never added to this file, so
# ten real statement PDFs (about 56MB) were committed and had to be purged from
# history. A per-directory rule only protects the directories someone remembered.
# ---------------------------------------------------------------------------
*.pdf
!fixtures/pdf/*.pdf          # synthetic only, regenerated by `npm run fixtures`
fixtures/real/
*.local.pdf
/corpus/candidates/
/corpus/court/
/corpus/dump/

.vercel
fixtures/reports/

# ---------------------------------------------------------------------------
# Blind evaluation artifacts.
#
# The frozen v0 run is permanent evidence, so it IS committed — the reports state
# conclusions, these files are the measurements behind them. Everything else
# under artifacts/ is scratch output from exploratory runs.
# ---------------------------------------------------------------------------
/artifacts/*
!/artifacts/blind-eval-v0/
