#!/bin/sh
#
# Reject large binaries and any PDF that is not a synthetic fixture.
#
# This exists because the rule it enforces was already broken once: ten real bank
# statement PDFs (about 56MB) were committed to corpus/court/ because that
# directory was never added to .gitignore, and they had to be purged from history
# afterwards. A .gitignore rule only protects the paths someone remembered; a hook
# protects the repository.
#
# Install with:  git config core.hooksPath .githooks
#
# Bypass with `git commit --no-verify` only when you are certain — and if you do,
# purge the object from history before pushing.

set -e

MAX_BYTES=1048576   # 1MB
staged=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$staged" ]; then
  exit 0
fi

blocked=0

for file in $staged; do
  [ -f "$file" ] || continue

  case "$file" in
    fixtures/pdf/*.pdf)
      # Synthetic, generated by `npm run fixtures`, small and reproducible.
      continue
      ;;
    *.pdf)
      echo "✗ refusing to commit a PDF: $file"
      echo "  Only synthetic fixtures under fixtures/pdf/ may be committed."
      echo "  Real statements stay on disk; commit only aggregate results."
      blocked=1
      continue
      ;;
  esac

  size=$(wc -c < "$file" | tr -d ' ')
  if [ "$size" -gt "$MAX_BYTES" ]; then
    echo "✗ refusing to commit $file ($size bytes, limit $MAX_BYTES)"
    echo "  Large binaries bloat the repository permanently. Store it outside git,"
    echo "  or commit a derived artifact instead."
    blocked=1
  fi
done

if [ "$blocked" -ne 0 ]; then
  echo ""
  echo "Commit aborted. See .githooks/pre-commit."
  exit 1
fi

exit 0
