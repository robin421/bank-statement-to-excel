---
import '../styles/global.css';
import { SITE } from '../data/site.mjs';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import { DEFAULT_LOCALE, LOCALES, type LocaleCode } from '../i18n';

export interface Props {
  title?: string;
  description?: string;
  /** Extra JSON-LD objects to inline on this page. */
  schema?: unknown[];
  /** Set on utility pages (404, thanks) that should never be indexed. */
  noindex?: boolean;
  /** Article metadata for blog posts. */
  article?: { published: string; modified?: string };
  /** Markdown pages receive their frontmatter here as well as spread onto props. */
  frontmatter?: Record<string, unknown>;
  /** UI language of this page. */
  locale?: LocaleCode;
  /**
   * Paths of this same page in other languages, e.g. { en: '/', de: '/de/' }.
   * Emitting hreflang for a page that does not exist is worse than emitting
   * none, so alternates are opt-in per page.
   */
  translations?: Partial<Record<LocaleCode, string>>;
  /** Override the canonical path. Used by the 404 page, which has no URL of its own. */
  canonicalPath?: string;
  /** Social preview image path (1200x630). Defaults to the site-wide image. */
  ogImage?: string;
}

const props = Astro.props as Props;
const frontmatter = (props.frontmatter ?? {}) as Record<string, string | undefined>;
const locale = props.locale ?? DEFAULT_LOCALE;

const title = props.title ?? frontmatter.title ?? SITE.name;
const description = props.description ?? frontmatter.description ?? SITE.description;
const schema = props.schema ?? [];
const noindex = props.noindex ?? false;
const article = props.article ?? (frontmatter.published ? { published: frontmatter.published } : undefined);

const origin = Astro.site ?? SITE.url;
// Normalise to a trailing slash so the canonical, the hreflang alternates and
// the sitemap all name the exact same URL. Emitting `/de` as the canonical while
// hreflang says `/de/` splits the signal between two URLs that both serve 200.
// `canonicalPath` exists for the 404 page, whose own path is not a real URL.
const rawPath = props.canonicalPath ?? Astro.url.pathname;
const pathname = rawPath.endsWith('/') ? rawPath : `${rawPath}/`;
const canonicalUrl = new URL(pathname, origin).href;
const ogTitle = title.includes(SITE.name) ? title : `${title} | ${SITE.name}`;
const ogImageUrl = new URL(props.ogImage ?? SITE.ogImage, origin).href;

const cfToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN;
const adsenseClient = import.meta.env.PUBLIC_ADSENSE_CLIENT;

// Only declare alternates when the page actually exists in more than one
// language; a lone hreflang pointing at a 404 wastes crawl budget. Skipped on
// noindex pages, which have nothing to consolidate.
const alternates = Object.entries(props.translations ?? {}) as Array<[LocaleCode, string]>;
const hasAlternates = alternates.length > 1 && !noindex;

const baseSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.url,
  inLanguage: LOCALES[locale].htmlLang,
};
---

<!doctype html>
<html lang={LOCALES[locale].htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{ogTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    {
      hasAlternates &&
        alternates.map(([code, path]) => (
          <link rel="alternate" hreflang={LOCALES[code].htmlLang} href={new URL(path, origin).href} />
        ))
    }
    {hasAlternates && <link rel="alternate" hreflang="x-default" href={new URL(alternates[0][1], origin).href} />}

    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={LOCALES[locale].htmlLang.replace('-', '_')} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={SITE.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={SITE.ogImageAlt} />
    {article && <meta property="article:published_time" content={article.published} />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <meta name="theme-color" content="#fbfaf7" />

    <script type="application/ld+json" set:html={JSON.stringify([baseSchema, ...schema])} is:inline />

    {cfToken && (
      <script
        defer
        is:inline
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: cfToken })}
      />
    )}
    {adsenseClient && (
      <script
        async
        is:inline
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseClient}`}
        crossorigin="anonymous"
      />
    )}
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Analytics />
    <Header locale={locale} translations={props.translations} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />

    {article && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify({
          '@context': 'https://schema.org',
          '@type': 'Article',
          headline: title,
          description,
          inLanguage: LOCALES[locale].htmlLang,
          datePublished: article.published,
          dateModified: article.modified ?? article.published,
          author: { '@type': 'Organization', name: SITE.name },
          publisher: { '@type': 'Organization', name: SITE.name },
          mainEntityOfPage: canonicalUrl,
        })}
        is:inline
      />
    )}
  </body>
</html>
