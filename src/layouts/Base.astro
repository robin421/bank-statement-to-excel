---
import '../styles/global.css';
import { SITE } from '../data/site.mjs';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title?: string;
  description?: string;
  /** Extra JSON-LD objects to inline on this page. */
  schema?: unknown[];
  /** Set on utility pages (404, thanks) that should never be indexed. */
  noindex?: boolean;
  /** Article metadata for blog posts. */
  article?: { published: string; modified?: string };
  /** Markdown pages receive their frontmatter here as well as spread onto props. */
  frontmatter?: Record<string, unknown>;
  /** Widen the content column (tool + SEO pages use the default page width). */
  wide?: boolean;
}

const props = Astro.props as Props;
const frontmatter = (props.frontmatter ?? {}) as Record<string, string | undefined>;

const title = props.title ?? frontmatter.title ?? SITE.name;
const description = props.description ?? frontmatter.description ?? SITE.description;
const schema = props.schema ?? [];
const noindex = props.noindex ?? false;
const article = props.article ?? (frontmatter.published ? { published: frontmatter.published } : undefined);

const canonicalUrl = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', Astro.site ?? SITE.url).href;
const ogTitle = title.includes(SITE.name) ? title : `${title} | ${SITE.name}`;

const cfToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN;
const adsenseClient = import.meta.env.PUBLIC_ADSENSE_CLIENT;

const baseSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.url,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{ogTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={SITE.name} />
    <meta name="twitter:card" content="summary_large_image" />
    {article && <meta property="article:published_time" content={article.published} />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#fbfaf7" />

    <script type="application/ld+json" set:html={JSON.stringify([baseSchema, ...schema])} is:inline />

    {cfToken && (
      <script
        defer
        is:inline
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: cfToken })}
      />
    )}
    {adsenseClient && (
      <script
        async
        is:inline
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseClient}`}
        crossorigin="anonymous"
      />
    )}
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    {article && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify({
          '@context': 'https://schema.org',
          '@type': 'Article',
          headline: title,
          description,
          datePublished: article.published,
          dateModified: article.modified ?? article.published,
          author: { '@type': 'Organization', name: SITE.name },
          publisher: { '@type': 'Organization', name: SITE.name },
          mainEntityOfPage: canonicalUrl,
        })}
        is:inline
      />
    )}
  </body>
</html>
