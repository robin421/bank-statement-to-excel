---
/**
 * Analytics and advertising tags, standard mode.
 *
 * Uses the plain synchronous gtag.js snippet (same pattern as bendcalc's
 * inject-web-seo.py) instead of Astro-bundled modules, to eliminate any
 * build-tooling variables from the tracking path.
 *
 * Renders nothing unless a Google measurement or publisher id is configured.
 */
import { ADSENSE_CLIENT_ID, GA4_MEASUREMENT_ID } from '../lib/analytics/gtag';

const enabled = Boolean(GA4_MEASUREMENT_ID || ADSENSE_CLIENT_ID);
---

{
  enabled && (
    <>
      {GA4_MEASUREMENT_ID && (
        <>
          <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA4_MEASUREMENT_ID}`}></script>
          <script
            is:inline
            set:html={`
              window.dataLayer = window.dataLayer || [];
              function gtag(){dataLayer.push(arguments);}
              gtag('js', new Date());
              gtag('config', '${GA4_MEASUREMENT_ID}', { anonymize_ip: true });
            `}
          />
        </>
      )}
      {ADSENSE_CLIENT_ID && (
        <script
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT_ID}`}
          crossorigin="anonymous"
        ></script>
      )}
    </>
  )
}
