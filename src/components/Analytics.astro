---
/**
 * Analytics and advertising tags, standard mode.
 *
 * Renders nothing unless a Google measurement or publisher id is configured,
 * which is the default in this repository — no script, no request.
 *
 * When an id is set, a single client script imports the tag module and loads the
 * configured tag immediately on page view. There is no consent banner and no
 * stored decision: the tags load directly.
 */
import { ADSENSE_CLIENT_ID, GA4_MEASUREMENT_ID } from '../lib/analytics/gtag';

const enabled = Boolean(GA4_MEASUREMENT_ID || ADSENSE_CLIENT_ID);
---

{
  enabled && (
    <script>
      import { ADSENSE_CLIENT_ID, GA4_MEASUREMENT_ID, loadAdsense, loadAnalytics } from '../lib/analytics/gtag';
      if (GA4_MEASUREMENT_ID) loadAnalytics();
      if (ADSENSE_CLIENT_ID) loadAdsense();
    </script>
  )
}
