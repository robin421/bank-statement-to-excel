---
import { SITE } from '../data/site.mjs';
import type { LocaleCode } from '../i18n';

export interface Props {
  /** Kept for Base.astro's signature; the tax site is English-only. */
  locale?: LocaleCode;
  translations?: Partial<Record<LocaleCode, string>>;
}

const links = [
  { href: '/no-tax-on-overtime-calculator/', label: 'Overtime' },
  { href: '/no-tax-on-tips-calculator/', label: 'Tips' },
  { href: '/schedule-1-a-guide/', label: 'Schedule 1-A' },
  { href: '/w2-box-12-code-tt/', label: 'Code TT' },
];
---

<header class="site-header">
  <div class="page site-header__inner">
    <a class="brand" href="/">
      <span class="brand__mark" aria-hidden="true">TAX</span>
      <span>{SITE.name}</span>
    </a>
    <nav class="site-nav" aria-label="Main">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
    {
      /* 移动端适配规范 §5：≤720px 时主导航收进汉堡菜单（CSS 控制显隐）。
         <details> 实现：无 JS 可用。 */
    }
    <details class="nav-toggle">
      <summary aria-label="Open menu">
        <span class="nav-toggle__icon" aria-hidden="true"></span>
      </summary>
      <nav class="nav-panel" aria-label="Main">
        {links.map((link) => <a href={link.href}>{link.label}</a>)}
      </nav>
    </details>
  </div>
</header>
