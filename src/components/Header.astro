---
import { SITE } from '../data/site.mjs';

const links = [
  { href: '/bank-statement-to-csv', label: 'CSV' },
  { href: '/quickbooks-csv', label: 'QuickBooks' },
  { href: '/xero-csv', label: 'Xero' },
  { href: '/scanned', label: 'Scanned PDFs' },
];
---

<header class="site-header">
  <div class="page site-header__inner">
    <a class="brand" href="/">
      <span class="brand__mark" aria-hidden="true">XLS</span>
      <span>{SITE.name}</span>
    </a>
    <nav class="site-nav" aria-label="Main">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
  </div>
</header>
