---
import Base from '../layouts/Base.astro';
import ConverterSection from './ConverterSection.astro';
import Faq from './Faq.astro';
import AdSlot from './AdSlot.astro';
import { HOME } from '../i18n/home';
import { LOCALE_CODES, LOCALES, type LocaleCode } from '../i18n';

export interface Props {
  locale: LocaleCode;
}

const { locale } = Astro.props;
const content = HOME[locale];

if (!content) throw new Error(`No homepage content for locale "${locale}"`);

const affiliateUrl = import.meta.env.PUBLIC_AFFILIATE_OCR_URL || undefined;

/**
 * Every locale has a homepage, so the alternates for this page are complete.
 * That is not true of the deeper pages yet — their hreflang stays English-only
 * until real translations exist, rather than pointing at 404s.
 */
const translations = Object.fromEntries(
  LOCALE_CODES.map((code) => [code, code === 'en' ? '/' : `/${code}/`]),
) as Partial<Record<LocaleCode, string>>;

/** Deeper pages exist in English only for now, so links stay absolute. */
const related = [
  { href: '/bank-statement-to-csv', title: 'CSV', blurb: content.eyebrow },
  { href: '/quickbooks-csv', title: 'QuickBooks Online', blurb: content.stats[1].label },
  { href: '/xero-csv', title: 'Xero', blurb: content.stats[1].label },
  { href: '/scanned', title: content.limitsHeading, blurb: content.limits[0] },
];

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: content.h1,
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Any (runs in the browser)',
  description: content.description,
  url: Astro.site ?? '',
  inLanguage: LOCALES[locale].htmlLang,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
---

<Base
  title={content.title}
  description={content.description}
  locale={locale}
  translations={translations}
  schema={[softwareSchema]}
>
  <ConverterSection eyebrow={content.eyebrow} locale={locale}>
    <h1>{content.h1}</h1>
    <p class="lede">{content.lede}</p>
  </ConverterSection>

  <section class="section section--tight">
    <div class="page">
      <ul class="stat-row">
        {
          content.stats.map((stat) => (
            <li class="stat">
              <div class="stat__value">{stat.value}</div>
              <div class="stat__label">{stat.label}</div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--sunken" aria-labelledby="how-heading">
    <div class="page">
      <h2 id="how-heading">{content.howHeading}</h2>
      <ol class="steps">
        {
          content.steps.map((step) => (
            <li>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="formats-heading">
    <div class="page">
      <div class="grid-2">
        <div class="prose">
          <h2 id="formats-heading">{content.formatsHeading}</h2>
          {content.formatsBody.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <div>
          <dl class="card" style="margin:0">
            {
              content.formatFacts.map((fact) => (
                <>
                  <dt style="font-weight:660;font-size:0.95rem">{fact.term}</dt>
                  <dd style="margin:0 0 0.9rem;color:var(--ink-soft);font-size:0.92rem">{fact.detail}</dd>
                </>
              ))
            }
          </dl>
        </div>
      </div>
    </div>
  </section>

  <AdSlot slot={`home-${locale}-mid`} />

  <section class="section section--sunken" aria-labelledby="banks-heading">
    <div class="page prose">
      <h2 id="banks-heading">{content.banksHeading}</h2>
      <p>{content.banksIntro}</p>
      <ul class="lang-list" style="font-size:0.95rem;gap:0.5rem 1.2rem">
        {content.banks.map((bank) => <li>{bank}</li>)}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="limits-heading">
    <div class="page prose">
      <h2 id="limits-heading">{content.limitsHeading}</h2>
      <ul class="callout-list">
        {
          content.limits.map((limit) => (
            <li>
              <span class="icon icon--no" aria-hidden="true">
                ✕
              </span>
              <span>{limit}</span>
            </li>
          ))
        }
      </ul>
      <p class="small muted">
        <a href="/terms">Terms</a> · <a href="/privacy">Privacy</a>
      </p>
    </div>
  </section>

  <Faq items={content.faqs} heading={content.faqHeading} />

  <AdSlot slot={`home-${locale}-bottom`} />

  <section class="section section--tight">
    <div class="page">
      <ul class="related">
        {
          related.map((item) => (
            <li>
              <a href={item.href}>
                <strong>{item.title}</strong>
                <span>{item.blurb}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="small muted" style="margin-top:1.2rem">
        This page is in {LOCALES[locale].label}. The deeper guides are currently English only —
        <a href="/">switch to the English homepage</a> for the full set.
      </p>
    </div>
  </section>
</Base>
