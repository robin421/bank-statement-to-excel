---
import { SITE } from '../data/site.mjs';

const year = new Date().getFullYear();
const badges = (SITE.featuredBadges ?? []) as string[];

const groups = [
  {
    heading: 'Calculators',
    links: [
      { href: '/', label: 'No tax on tips and overtime' },
      { href: '/no-tax-on-overtime-calculator/', label: 'No tax on overtime calculator' },
      { href: '/no-tax-on-tips-calculator/', label: 'No tax on tips calculator' },
    ],
  },
  {
    heading: 'Guides',
    links: [
      { href: '/schedule-1-a-guide/', label: 'Schedule 1-A line by line' },
      { href: '/w2-box-12-code-tt/', label: 'W-2 box 12 code TT' },
      { href: '/blog/', label: 'All guides' },
    ],
  },
  {
    heading: 'Site',
    links: [
      { href: '/about/', label: 'About' },
      { href: '/contact/', label: 'Contact' },
      { href: '/privacy/', label: 'Privacy' },
      { href: '/terms/', label: 'Terms' },
    ],
  },
];
---

<footer class="site-footer">
  <div class="page">
    <div class="footer-grid">
      {
        groups.map((group) => (
          <div>
            <h3>{group.heading}</h3>
            <ul>
              {group.links.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    {
      badges.length > 0 && (
        <div class="footer-badges" aria-label="Featured on">
          <span class="footer-badges__label">Featured on</span>
          {badges.map((html) => (
            <span class="footer-badge" set:html={html} />
          ))}
        </div>
      )
    }

    <div class="footer-legal">
      <p>
        <strong>Not tax advice.</strong> {SITE.name} is an independent site and is not affiliated with the IRS or the
        U.S. Treasury. The calculators estimate federal income tax only, from published IRS guidance; check your own
        W-2, 1099 and the Schedule 1-A instructions, or ask a tax professional, before you file.
      </p>
      <p>&copy; {year} {SITE.name}. Everything you type into a calculator stays in your browser.</p>
    </div>
  </div>
</footer>
