---
import { PLAY_URL } from '../../lib/tax/content';
---
<aside class="page" aria-label="Shift Work Calendar app" style="max-width:48rem">
  <div class="card" style="background:var(--warn-soft);border-color:#f1d9b5">
    <p style="margin:0 0 0.6rem"><strong>Work overtime or rotating shifts?</strong> Shift Work Calendar plans your rotation and lets you log overtime on any day, so you can check your hours against your pay stubs.</p>
    <a class="btn btn--primary" href={PLAY_URL} rel="noopener" target="_blank">Get Shift Work Calendar on Google Play</a>
  </div>
</aside>
