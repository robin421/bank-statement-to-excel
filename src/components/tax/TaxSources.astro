---
import type { Source } from '../../lib/tax/content';
import { TAX_UPDATED, DISCLAIMER } from '../../lib/tax/content';
export interface Props { sources: Source[]; changelog?: Array<[string, string]> }
const { sources, changelog = [[TAX_UPDATED, 'First published.']] } = Astro.props;
---
<section class="section section--tight" aria-labelledby="sources-heading">
  <div class="page" style="max-width:48rem">
    <h2 id="sources-heading">Sources and last updated</h2>
    <p class="small">Last updated: <time datetime={TAX_UPDATED}>{TAX_UPDATED}</time> · Tax year: 2026 · Maintained by the <a href="/about/">WattFlow team</a>. No CPA or EA has reviewed this page.</p>
    <ul class="small">
      {sources.map((s) => <li><a href={s.url} rel="noopener" target="_blank">{s.label}</a></li>)}
    </ul>
    <h3 style="font-size:1rem">Changelog</h3>
    <ul class="small">{changelog.map(([d, t]) => <li><time datetime={d}>{d}</time> — {t}</li>)}</ul>
    <p class="small muted">{DISCLAIMER()}</p>
  </div>
</section>
