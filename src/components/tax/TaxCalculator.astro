---
import { TTOC } from '../../lib/tax/ttoc';
import { DISCLAIMER } from '../../lib/tax/content';

export interface Props {
  kind: 'overtime' | 'tips';
  /** Compact overtime calculator (W-2 code TT only) for explainer pages. */
  compact?: boolean;
}
const { kind, compact = false } = Astro.props;
const id = `tc-${kind}${compact ? '-c' : ''}`;
---

<div class="taxcalc card" data-taxcalc={kind} data-compact={compact ? '1' : '0'} id={id}>
  <form class="taxcalc__form" novalidate>
    <div class="taxcalc__grid">
      <div class="field">
        <label for={`${id}-year`}>Tax year</label>
        <select class="select" id={`${id}-year`} name="year">
          <option value="2026" selected>2026</option>
          <option value="2025">2025</option>
        </select>
      </div>
      <div class="field">
        <label for={`${id}-status`}>Filing status</label>
        <select class="select" id={`${id}-status`} name="status">
          <option value="single">Single</option>
          <option value="mfj">Married filing jointly</option>
          <option value="hoh">Head of household</option>
          <option value="qss">Qualifying surviving spouse</option>
          <option value="mfs">Married filing separately</option>
        </select>
      </div>
    </div>

    {kind === 'overtime' && (
      <fieldset class="taxcalc__set">
        <legend>Qualified overtime</legend>
        {!compact && (
          <div class="taxcalc__modes" role="radiogroup" aria-label="How to enter overtime">
            <label><input type="radio" name="mode" value="w2" checked /> I have my W-2 (box 12, code TT)</label>
            <label><input type="radio" name="mode" value="estimate" /> Estimate from my pay</label>
          </div>
        )}
        <div data-show="w2" class="taxcalc__grid">
          <div class="field">
            <label for={`${id}-tt`}>Your W-2 box 12, code TT</label>
            <input class="input" id={`${id}-tt`} name="tt" inputmode="decimal" placeholder="e.g. 3125" />
          </div>
          <div class="field" data-show-status="mfj">
            <label for={`${id}-tt2`}>Spouse’s W-2 box 12, code TT</label>
            <input class="input" id={`${id}-tt2`} name="tt2" inputmode="decimal" placeholder="0" />
          </div>
        </div>
        {!compact && (
          <div data-show="estimate" hidden>
            <div class="taxcalc__grid">
              <div class="field"><label for={`${id}-rate`}>Regular hourly rate ($)</label><input class="input" id={`${id}-rate`} name="rate" inputmode="decimal" placeholder="25" /></div>
              <div class="field"><label for={`${id}-hpw`}>FLSA overtime hours per week</label><input class="input" id={`${id}-hpw`} name="hpw" inputmode="decimal" placeholder="5" /><span class="field__hint">Hours over 40 in a workweek</span></div>
              <div class="field"><label for={`${id}-weeks`}>Weeks with overtime</label><input class="input" id={`${id}-weeks`} name="weeks" inputmode="decimal" placeholder="50" /></div>
              <div class="field"><label for={`${id}-hours`}>…or total FLSA overtime hours this year</label><input class="input" id={`${id}-hours`} name="hours" inputmode="decimal" placeholder="optional" /></div>
              <div class="field">
                <label for={`${id}-mult`}>Overtime multiplier paid</label>
                <select class="select" id={`${id}-mult`} name="mult"><option value="1.5">1.5× (time-and-a-half)</option><option value="2">2× (double time)</option></select>
              </div>
            </div>
            <p class="small muted" data-mult-note hidden>Paid double time? Only the 0.5× the FLSA requires counts — the extra 0.5× doesn’t.</p>
            <p class="small taxcalc__est" data-est></p>
          </div>
        )}
        <label class="taxcalc__check"><input type="checkbox" name="flsa" checked /> I’m an FLSA non-exempt employee (overtime-eligible under federal law)</label>
      </fieldset>
    )}

    {kind === 'tips' && (
      <fieldset class="taxcalc__set">
        <legend>Qualified tips</legend>
        <div class="field">
          <label for={`${id}-occ`}>Occupation (W-2 box 14b code)</label>
          <select class="select" id={`${id}-occ`} name="occ">
            <option value="">Not listed / not sure</option>
            {TTOC.map(([c, t]) => <option value={c}>{c} — {t}</option>)}
            <option value="000">000 — non-qualifying occupation</option>
          </select>
          <span class="field__hint"><a href="https://www.irs.gov/forms-pubs/occupations-that-customarily-and-regularly-received-tips-on-or-before-dec-31-2024" rel="noopener" target="_blank">IRS tipped occupations list</a></span>
        </div>
        <div class="taxcalc__grid">
          <div class="field"><label for={`${id}-tp`}>W-2 box 12, code TP</label><input class="input" id={`${id}-tp`} name="tp" inputmode="decimal" placeholder="0" /><span class="field__hint">Employees</span></div>
          <div class="field"><label for={`${id}-se`}>Tips on 1099-NEC / 1099-MISC / 1099-K</label><input class="input" id={`${id}-se`} name="se" inputmode="decimal" placeholder="0" /><span class="field__hint">Self-employed / gig work</span></div>
          <div class="field"><label for={`${id}-np`}>Net profit of that business</label><input class="input" id={`${id}-np`} name="np" inputmode="decimal" placeholder="self-employed only" /></div>
        </div>
        <label class="taxcalc__check"><input type="checkbox" name="voluntary" checked /> Tips were voluntary — not a mandatory service charge</label>
      </fieldset>
    )}

    <div class="taxcalc__grid">
      <div class="field">
        <label for={`${id}-magi`}>Modified AGI (MAGI)</label>
        <input class="input" id={`${id}-magi`} name="magi" inputmode="decimal" placeholder="e.g. 60000" />
        <span class="field__hint">Form 1040 line 11b, plus any excluded foreign or territory income</span>
      </div>
      {!compact && (
        <div class="field">
          <label for={`${id}-ded`}>Standard or itemized deduction (optional)</label>
          <input class="input" id={`${id}-ded`} name="ded" inputmode="decimal" placeholder="2026 standard deduction" />
          <span class="field__hint">Used only for the tax-saved estimate</span>
        </div>
      )}
    </div>
    <label class="taxcalc__check"><input type="checkbox" name="ssn" checked /> I have a Social Security number valid for employment</label>
  </form>

  <section class="taxcalc__out" aria-live="polite">
    <dl class="taxcalc__rows">
      <div><dt>Qualified amount</dt><dd data-out="qualified">$0</dd></div>
      <div><dt>After the cap</dt><dd data-out="capped">$0</dd></div>
      <div><dt>Phase-out reduction</dt><dd data-out="reduction">$0</dd></div>
      <div class="taxcalc__total"><dt>Your deduction</dt><dd data-out="deduction">$0</dd></div>
      <div><dt>Federal income tax saved (est.)</dt><dd data-out="saved">—</dd></div>
    </dl>
    <ul class="taxcalc__notes small" data-out="notes"></ul>
    <p class="small muted">
      Doesn’t reduce FICA (7.65%). Whether your state follows this deduction depends on your state. Claimed on
      Schedule 1-A, {kind === 'tips' ? 'Part II' : 'Part III'}.
    </p>
    <div class="taxcalc__actions">
      <button type="button" class="btn btn--ghost" data-copy>Copy result</button>
      <button type="button" class="btn btn--ghost" data-print>Print</button>
    </div>
    <p class="small muted taxcalc__disc">{DISCLAIMER()}</p>
  </section>
</div>

<style>
  .taxcalc { display: grid; gap: 1.1rem; }
  .taxcalc__grid { display: grid; gap: 0.8rem; grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr)); }
  .taxcalc__form { display: grid; gap: 0.9rem; }
  .taxcalc__set { border: 0; padding: 0; margin: 0; display: grid; gap: 0.7rem; min-width: 0; }
  .taxcalc__set legend { font-weight: 700; margin-bottom: 0.4rem; }
  .taxcalc__modes { display: flex; flex-wrap: wrap; gap: 0.4rem 1.2rem; font-size: 0.92rem; }
  .taxcalc__check { display: flex; gap: 0.5rem; align-items: flex-start; font-size: 0.9rem; }
  .taxcalc__check input { margin-top: 0.25rem; }
  .taxcalc .input, .taxcalc .select { font-size: 16px; padding: 0.6rem 0.7rem; }
  .taxcalc__out { background: var(--accent-soft); border-radius: var(--radius); padding: 1rem 1.1rem; }
  .taxcalc__rows { margin: 0; display: grid; gap: 0.35rem; }
  .taxcalc__rows > div { display: flex; justify-content: space-between; gap: 1rem; }
  .taxcalc__rows dt { color: var(--ink-soft); }
  .taxcalc__rows dd { margin: 0; font-variant-numeric: tabular-nums; font-weight: 600; }
  .taxcalc__total { border-top: 1px solid var(--rule-strong); padding-top: 0.4rem; font-size: 1.15rem; }
  .taxcalc__total dd { color: var(--accent-ink); font-weight: 800; }
  .taxcalc__notes { margin: 0.7rem 0 0; padding-left: 1.1rem; }
  .taxcalc__actions { display: flex; gap: 0.6rem; flex-wrap: wrap; }
  .taxcalc__est { margin: 0.4rem 0 0; font-weight: 600; }
  .taxcalc__disc { margin-bottom: 0; }
  @media print { .site-header, .site-footer, .ad-slot, .taxcalc__actions { display: none !important; } }
</style>

<script>
  import { estimateOvertimePremium, overtimeDeduction, tipsDeduction, toAmount, type FilingStatus } from '../../lib/tax/rules';

  const usd = (n: number) => '$' + Math.round(n).toLocaleString('en-US');

  for (const root of document.querySelectorAll<HTMLElement>('[data-taxcalc]')) {
    const form = root.querySelector('form')!;
    const kind = root.dataset.taxcalc;
    const val = (name: string) => (form.elements.namedItem(name) as HTMLInputElement | null)?.value ?? '';
    const checked = (name: string) => (form.elements.namedItem(name) as HTMLInputElement | null)?.checked ?? false;
    const out = (k: string) => root.querySelector<HTMLElement>(`[data-out="${k}"]`)!;
    let summary = '';

    const render = () => {
      const taxYear = Number(val('year'));
      const filingStatus = val('status') as FilingStatus;
      const magi = toAmount(val('magi'));
      const dedRaw = val('ded').trim();
      const belowLineDeduction = dedRaw === '' ? undefined : toAmount(dedRaw);
      const validSsn = checked('ssn');
      const extra: string[] = [];

      root.querySelectorAll<HTMLElement>('[data-show-status]').forEach((el) => (el.hidden = el.dataset.showStatus !== filingStatus));

      let r;
      if (kind === 'overtime') {
        const mode = (form.querySelector<HTMLInputElement>('input[name="mode"]:checked')?.value) ?? 'w2';
        root.querySelectorAll<HTMLElement>('[data-show]').forEach((el) => (el.hidden = el.dataset.show !== mode));
        let tt = [toAmount(val('tt')), toAmount(val('tt2'))];
        if (mode === 'estimate') {
          const hours = val('hours').trim() !== '' ? toAmount(val('hours')) : toAmount(val('hpw')) * toAmount(val('weeks'));
          const est = estimateOvertimePremium(toAmount(val('rate')), hours);
          tt = [est, 0];
          const multNote = root.querySelector<HTMLElement>('[data-mult-note]');
          if (multNote) multNote.hidden = val('mult') !== '2';
          root.querySelector<HTMLElement>('[data-est]')!.textContent = `Estimated qualified premium: ${usd(est)} (0.5 × rate × ${hours.toLocaleString('en-US')} h)`;
          extra.push(taxYear >= 2026 ? 'Estimate only — for 2026 the deduction is limited to what your W-2 shows in box 12, code TT.' : 'Estimate only — for 2025 you can figure the amount yourself under Notice 2025-69.');
        }
        r = overtimeDeduction({ taxYear, filingStatus, validSsn, magi, ttAmounts: tt, flsaNonExempt: checked('flsa'), belowLineDeduction });
      } else {
        const np = val('np').trim();
        const se = toAmount(val('se'));
        if (se > 0 && np === '') extra.push('Self-employed? Enter the net profit of that business — the deduction can’t exceed it.');
        r = tipsDeduction({
          taxYear, filingStatus, validSsn, magi, belowLineDeduction,
          occupationCode: val('occ'), w2Tips: toAmount(val('tp')), selfEmployedTips: se,
          selfEmployedNetProfit: np === '' ? undefined : toAmount(np), voluntaryTips: checked('voluntary'),
        });
      }
      out('qualified').textContent = usd(r.qualified);
      out('capped').textContent = usd(r.capped);
      out('reduction').textContent = r.reduction ? '−' + usd(r.reduction) : '$0';
      out('deduction').textContent = usd(r.deduction);
      out('saved').textContent = r.taxSaved === null ? 'n/a for 2025' : usd(r.taxSaved);
      const notes = [...(r.reason ? [r.reason] : []), ...r.notes, ...extra];
      out('notes').replaceChildren(...notes.map((n) => Object.assign(document.createElement('li'), { textContent: n })));
      summary = `${kind === 'tips' ? 'No Tax on Tips' : 'No Tax on Overtime'} (${taxYear}, ${filingStatus.toUpperCase()}): qualified ${usd(r.qualified)}, capped ${usd(r.capped)}, phase-out ${usd(r.reduction)}, deduction ${usd(r.deduction)}${r.taxSaved ? `, est. federal tax saved ${usd(r.taxSaved)}` : ''}. Estimate only — www.wattflow.net`;
    };

    form.addEventListener('input', render);
    form.addEventListener('change', render);
    form.addEventListener('submit', (e) => e.preventDefault());
    root.querySelector('[data-copy]')?.addEventListener('click', async (e) => {
      const btn = e.currentTarget as HTMLButtonElement;
      try { await navigator.clipboard.writeText(summary); btn.textContent = 'Copied'; } catch { btn.textContent = 'Copy failed'; }
      setTimeout(() => (btn.textContent = 'Copy result'), 1500);
    });
    root.querySelector('[data-print]')?.addEventListener('click', () => window.print());
    render();
  }
</script>
