---
import Base from '../../layouts/Base.astro';

const posts = [
  {
    href: '/schedule-1-a-guide/',
    title: 'Schedule 1-A instructions 2026: line-by-line guide',
    blurb: 'Parts I–III of the 2026 draft form, with worked examples for a server, a married couple in the phase-out and a 1099 driver.',
  },
  {
    href: '/w2-box-12-code-tt/',
    title: 'W-2 box 12 code TT: what it means for 2026 taxes',
    blurb: 'The new qualified-overtime code, why it caps your deduction, and what to do if it is wrong.',
  },
];
---

<Base
  title="Guides — No Tax on Tips and Overtime"
  description="Plain-English guides to the 2025–2028 no tax on tips and no tax on overtime deductions: Schedule 1-A line by line and the new W-2 codes."
>
  <section class="section">
    <div class="page">
      <p class="eyebrow">Guides</p>
      <h1>No tax on tips and overtime guides</h1>
      <p class="lede">
        Short, sourced guides to filling in the forms. Each one links to the IRS documents it relies on.
      </p>

      <ul class="related" style="margin-top:2rem">
        {
          posts.map((post) => (
            <li>
              <a href={post.href}>
                <strong>{post.title}</strong>
                <span>{post.blurb}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>
