---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import ConverterSection from '../../components/ConverterSection.astro';
import Faq from '../../components/Faq.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import { verifiedBanks, type Bank } from '../../data/banks';

/**
 * Only verified banks get a page.
 *
 * Publishing one generic page per bank with the name swapped is a doorway page
 * by Google's own definition, and it is not worth the risk for a long-tail
 * query. A page here carries a real test result instead — see the README for the
 * verification workflow.
 */
export const getStaticPaths = (() =>
  verifiedBanks().map((bank) => ({
    params: { bank: bank.slug },
    props: { bank },
  }))) satisfies GetStaticPaths;

const { bank } = Astro.props as { bank: Bank };

const latest = bank.verifications[bank.verifications.length - 1];
const confirmed = bank.layoutNotes.filter((note) => note.state === 'confirmed');
const refuted = bank.layoutNotes.filter((note) => note.state === 'refuted');
const untested = bank.layoutNotes.filter((note) => note.state === 'hypothesis');

const faqs = [
  {
    q: `How was the ${bank.name} layout tested?`,
    a: `A real ${bank.name} statement was parsed on ${latest.date}. It ran ${latest.pages} page${latest.pages === 1 ? '' : 's'} and ${latest.rows} transactions, and ${(latest.reconcileRate * 100).toFixed(0)}% of the consecutive rows reconciled against the running balance printed on the statement itself. That check is the evidence: a missed or misread row breaks the balance chain at that point.`,
  },
  {
    q: `Does this mean every ${bank.name} statement will work?`,
    a: `No. Banks change layouts without notice, and the same bank prints different statements for different account types and countries. What the test shows is that this layout converted cleanly. If yours differs, the converter still tries — look at the reconcile count in the preview to judge the result.`,
  },
  {
    q: 'What should I check before using the output?',
    a: 'Three things: the number of rows against your statement, the total of the amount column, and the final balance against the closing balance printed on the statement. If all three agree, the conversion is complete.',
  },
  {
    q: 'Is any of my data sent anywhere?',
    a: 'No. The PDF is opened and parsed inside your browser tab. There is no upload, no account and no storage.',
  },
];

const related = [
  { href: '/', title: 'Bank statement to Excel', blurb: 'The converter, and how the balance check works.' },
  { href: '/banks/', title: 'All tested banks', blurb: 'Which statement layouts have been verified, and how to get the right file.' },
  { href: '/bank-statement-to-csv/', title: 'Bank statement to CSV', blurb: 'If you need CSV rather than a workbook.' },
  { href: '/quickbooks-csv/', title: 'QuickBooks Online', blurb: 'The three-column import shape.' },
];

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: `Convert a ${bank.name} statement to Excel`,
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Any (runs in the browser)',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
---

<Base
  title={`${bank.name} Bank Statement to Excel — Tested Layout`}
  description={`Convert a ${bank.name} bank statement PDF to Excel or CSV in your browser. This layout has been tested: ${latest.rows} transactions parsed, ${(latest.reconcileRate * 100).toFixed(0)}% of rows reconciled against the statement's own running balance.`}
  schema={[softwareSchema]}
>
  <ConverterSection eyebrow={`${bank.name} · ${bank.country} · ${bank.currency}`}>
    <h1>Convert a {bank.name} bank statement to Excel</h1>
    <p class="lede">
      Drop in a {bank.name} statement PDF downloaded from online banking and get a spreadsheet back. This layout has been
      tested against a real statement; the results are below, including anything that did not work.
    </p>
  </ConverterSection>

  <section class="section section--tight">
    <div class="page">
      <div class="card" style="border-color:var(--accent);max-width:52rem">
        <div style="display:flex;flex-wrap:wrap;gap:0.8rem;align-items:center">
          <span class="badge badge--ok">
            <span class="badge__dot" aria-hidden="true" />
            Tested {(latest.reconcileRate * 100).toFixed(0)}% reconciled
          </span>
          <span class="badge badge--neutral">{latest.rows} transactions</span>
          <span class="badge badge--neutral">
            {latest.pages} page{latest.pages === 1 ? '' : 's'}
          </span>
          <span class="badge badge--neutral">Tested {latest.date}</span>
        </div>
        <p class="small muted" style="margin:0.9rem 0 0">
          “Reconciled” means each row’s balance matched the previous balance plus that row’s amount, to the cent, across
          the whole statement. A missed or misread row breaks that chain, so it is a real check rather than a sample.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--sunken" aria-labelledby="layout-heading">
    <div class="page">
      <div class="grid-2">
        <div class="prose">
          <h2 id="layout-heading">What the {bank.name} layout actually does</h2>
          <p>
            Only what was observed in the test. Where the statement behaved as expected it is marked confirmed; where it
            did not, that is recorded too.
          </p>
          {
            confirmed.length > 0 && (
              <ul class="callout-list">
                {confirmed.map((note) => (
                  <li>
                    <span class="icon" aria-hidden="true">
                      ✓
                    </span>
                    <span>
                      {note.text}
                      {note.observation && <><br /><span class="small muted">Observed: {note.observation}</span></>}
                    </span>
                  </li>
                ))}
              </ul>
            )
          }
          {
            refuted.length > 0 && (
              <>
                <h3>Did not hold</h3>
                <ul class="callout-list">
                  {refuted.map((note) => (
                    <li>
                      <span class="icon icon--no" aria-hidden="true">
                        ✕
                      </span>
                      <span>
                        {note.text}
                        {note.observation && <><br /><span class="small muted">Observed: {note.observation}</span></>}
                      </span>
                    </li>
                  ))}
                </ul>
              </>
            )
          }
          {
            untested.length > 0 && (
              <p class="small muted">
                {untested.length} characteristic{untested.length === 1 ? '' : 's'} of this layout {untested.length === 1 ? 'was' : 'were'} not
                covered by the statement we tested, so nothing is claimed about {untested.length === 1 ? 'it' : 'them'}.
              </p>
            )
          }
        </div>

        <div>
          <div class="card">
            <h2 style="margin-top:0;font-size:1.05rem">How to check the output</h2>
            <ol style="padding-left:1.15em">
              <li>The reconcile badge in the preview should say every row reconciles.</li>
              <li>
                The <strong>last balance</strong> in the table should equal the closing balance on your statement.
              </li>
              <li>Filter the preview to rows needing a check and compare those against the PDF.</li>
            </ol>
            <p style="margin-bottom:0">
              If the last balance matches and nothing is flagged, the conversion is complete.
            </p>
          </div>

          <div class="card" style="margin-top:1rem">
            <h2 style="margin-top:0;font-size:1.05rem">Getting a readable file</h2>
            <p style="margin-bottom:0">{bank.exportPath}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="page">
      <p class="small muted" style="max-width:70ch">
        <strong>{bank.name} is a trademark of its owner.</strong> This site is independent and is not affiliated with,
        endorsed by or connected to {bank.name}. The name is used only to describe the statement format that was tested.
        Always verify converted figures against your original statement before relying on them.
      </p>
    </div>
  </section>

  <Faq items={faqs} />

  <RelatedLinks heading="Related" items={related} />
</Base>
