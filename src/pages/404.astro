---
import Base from '../layouts/Base.astro';
import RelatedLinks from '../components/RelatedLinks.astro';

const related = [
  { href: '/no-tax-on-overtime-calculator/', title: 'No tax on overtime calculator', blurb: 'W-2 code TT, caps and phase-out.' },
  { href: '/no-tax-on-tips-calculator/', title: 'No tax on tips calculator', blurb: 'W-2 code TP, 1099 tips and the $25,000 cap.' },
  { href: '/schedule-1-a-guide/', title: 'Schedule 1-A line by line', blurb: 'Where each number goes on the 2026 form.' },
  { href: '/blog/', title: 'Guides', blurb: 'All tax guides.' },
];
---

<Base
  title="Page Not Found"
  description="That page does not exist. The no tax on tips and overtime calculators are on the homepage."
  noindex
  canonicalPath="/"
>
  <section class="section">
    <div class="page prose">
      <p class="eyebrow">404</p>
      <h1>That page does not exist</h1>
      <p class="lede">The link may be old, or the address may have a typo.</p>
      <p>
        <a class="btn btn--primary" href="/">Go to the tax calculators</a>
      </p>
    </div>
  </section>

  <RelatedLinks heading="Popular pages" items={related} />
</Base>
