---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import AdSlot from '../components/AdSlot.astro';
import TaxCalculator from '../components/tax/TaxCalculator.astro';
import TaxSources from '../components/tax/TaxSources.astro';
import AppPromo from '../components/tax/AppPromo.astro';
import { OT_FAQ, SRC } from '../lib/tax/content';
import { taxPageSchema } from '../lib/tax/schema';
import { SITE } from '../data/site.mjs';

const title = 'No Tax on Overtime Calculator 2026 (W-2 Code TT) | WattFlow';
const description =
  'Estimate your 2026 overtime deduction in seconds. Uses only the FLSA premium (the "half" in time-and-a-half), the $12,500/$25,000 caps and the $150k/$300k phase-out.';
const schema = taxPageSchema({ origin: Astro.site?.href ?? SITE.url, path: '/no-tax-on-overtime-calculator/', name: 'No Tax on Overtime Calculator', description, app: true });
const related = [
  { href: '/no-tax-on-tips-calculator/', title: 'No tax on tips calculator', blurb: 'Up to $25,000 of qualified tips, W-2 code TP and 1099 tips.' },
  { href: '/w2-box-12-code-tt/', title: 'W-2 box 12 code TT explained', blurb: 'What the new overtime code means, and what to do if it is wrong.' },
  { href: '/schedule-1-a-guide/', title: 'Schedule 1-A line by line', blurb: 'Where your overtime goes in Part III of the 2026 form.' },
];
---

<Base title={title} description={description} fullTitle locale="en" schema={schema}>
  <section class="section section--tight">
    <div class="page" style="max-width:48rem">
      <p class="eyebrow">Tax year 2026 · Runs in your browser · Nothing uploaded</p>
      <h1>No Tax on Overtime Calculator (2026 and 2025)</h1>
      <p class="lede">
        For 2025–2028 you can deduct the overtime premium your employer is required to pay under the FLSA — usually the
        “half” of time-and-a-half — up to $12,500 ($25,000 married filing jointly), reduced above $150,000 MAGI
        ($300,000 joint). It is a federal income-tax deduction, not tax-free pay: Social Security and Medicare still apply.
      </p>
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="how-heading">
    <div class="page" style="max-width:48rem">
      <h2 id="how-heading">How the no tax on overtime deduction works (2025–2028)</h2>
      <p>
        The deduction is claimed on Schedule 1-A, Part III, and you can take it whether you itemize or use the standard
        deduction. It lowers your federal taxable income; it doesn’t change what is withheld for Social Security and
        Medicare. Married couples must file jointly, and whoever earned the overtime needs a Social Security number valid
        for employment.
      </p>
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="calc-heading">
    <div class="page" style="max-width:48rem">
      <h2 id="calc-heading">Calculator</h2>
      <TaxCalculator kind="overtime" />
    </div>
  </section>

  <AppPromo />

  <section class="section section--tight" aria-labelledby="counts-heading">
    <div class="page" style="max-width:48rem">
      <h2 id="counts-heading">What counts as qualified overtime (and what doesn’t)</h2>
      <ul>
        <li><strong>Counts:</strong> the part of FLSA overtime pay above your regular rate. At $20/hour with time-and-a-half, $10 of each $30 overtime hour.</li>
        <li><strong>Double time:</strong> only the 0.5× the FLSA requires. The extra 0.5× doesn’t count.</li>
        <li><strong>Doesn’t count:</strong> overtime paid only because of state law (such as daily overtime) or a union contract, and any overtime paid to someone who isn’t covered by the FLSA or is exempt from its overtime rules.</li>
      </ul>
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="tt-heading">
    <div class="page" style="max-width:48rem">
      <h2 id="tt-heading">2026 change: use W-2 box 12 code TT</h2>
      <p>
        Starting with 2026 Forms W-2, employers report qualified overtime in box 12 with code TT. For tax years after
        2025 the IRS says you can’t deduct more than the code TT amount. If it’s missing or too low, you need a corrected
        W-2 (Form W-2c) from your employer — see <a href="/w2-box-12-code-tt/">W-2 box 12 code TT explained</a>.
        For 2025, employers didn’t have to report it separately and you could figure the amount yourself under Notice 2025-69.
      </p>
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="limits-heading">
    <div class="page" style="max-width:48rem">
      <h2 id="limits-heading">Limits and income phase-out</h2>
      <div class="tbl-wrap" style="overflow-x:auto">
        <table>
          <thead><tr><th></th><th>Single, HoH, surviving spouse</th><th>Married filing jointly</th></tr></thead>
          <tbody>
            <tr><th>Maximum deduction</th><td>$12,500</td><td>$25,000</td></tr>
            <tr><th>Phase-out starts (MAGI)</th><td>$150,000</td><td>$300,000</td></tr>
            <tr><th>Fully phased out at a full cap</th><td>$275,000</td><td>$550,000</td></tr>
            <tr><th>Married filing separately</th><td colspan="2">Not allowed</td></tr>
          </tbody>
        </table>
      </div>
      <p>
        The deduction falls by $100 for each full $1,000 of MAGI over the threshold: subtract the threshold, divide by
        1,000 and round down to a whole number. For example, $12,400 over → 12 → $1,200 off.
      </p>
    </div>
  </section>

  <AdSlot adSlot="tax-ot-mid" />

  <section class="section section--tight" aria-labelledby="ex-heading">
    <div class="page" style="max-width:48rem">
      <h2 id="ex-heading">Worked examples</h2>
      <ol>
        <li><strong>Hourly worker.</strong> $25/hour, 5 overtime hours a week for 50 weeks = 250 hours. Qualified amount = 0.5 × $25 × 250 = <strong>$3,125</strong>. Single, AGI $60,000, no phase-out. Taxable income goes from $43,900 to $40,775, all in the 12% bracket — about <strong>$375</strong> saved.</li>
        <li><strong>Double time.</strong> $30/hour, 10 hours over 40 paid at 2×. Only 0.5 × $30 × 10 = <strong>$150</strong> counts, not $300.</li>
        <li><strong>Joint phase-out.</strong> Married filing jointly, code TT totals $14,000, MAGI $320,000. $20,000 over → $2,000 off → <strong>$12,000</strong> deduction.</li>
        <li><strong>State daily overtime.</strong> A California employee works 10 hours one day but 38 hours that week. Those 2 daily-overtime hours aren’t required by the FLSA, so they <strong>don’t count</strong>.</li>
      </ol>
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="claim-heading">
    <div class="page" style="max-width:48rem">
      <h2 id="claim-heading">How to claim it on Schedule 1-A (Part III)</h2>
      <p>
        Enter your qualified overtime in Part III of Schedule 1-A, apply the cap, then the MAGI reduction, and carry the
        result to your Form 1040. Attach Schedule 1-A to Form 1040, 1040-SR or 1040-NR. Step by step:
        <a href="/schedule-1-a-guide/">Schedule 1-A line-by-line guide</a>.
      </p>
      <h3>Methodology</h3>
      <p class="small">
        Deduction = max(0, min(qualified overtime, cap) − floor(max(0, MAGI − threshold) / 1,000) × $100). The tax-saved
        estimate is your 2026 federal tax before minus after the deduction, using the 2026 rate tables and standard
        deduction from Rev. Proc. 2025-32 (Single $16,100, MFJ $32,200, HoH $24,150) — not deduction × marginal rate,
        which is wrong across a bracket edge. It treats MAGI as your AGI and ignores credits and capital-gain rates. No
        2025 tax-saved estimate is shown. Every calculation happens in your browser.
      </p>
    </div>
  </section>

  <Faq items={OT_FAQ} heading="No tax on overtime FAQ" />

  <RelatedLinks heading="Related" items={related} />

  <TaxSources sources={[SRC.fs202503, SRC.s1a, SRC.fs202613, SRC.otQa, SRC.n2569, SRC.iw2, SRC.fw2, SRC.rp2532]} />
</Base>
