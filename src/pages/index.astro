---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import TaxSources from '../components/tax/TaxSources.astro';
import { HUB_FAQ, SRC } from '../lib/tax/content';
import { taxPageSchema } from '../lib/tax/schema';
import { SITE } from '../data/site.mjs';

const title = 'No Tax on Tips and Overtime Calculators 2026 | WattFlow';
const description =
  'Free 2026 calculators for the no tax on tips and no tax on overtime deductions: $25,000 tips cap, $12,500/$25,000 overtime cap, $150k/$300k phase-out, W-2 codes TT and TP.';
const schema = taxPageSchema({
  origin: Astro.site?.href ?? SITE.url,
  path: '/',
  name: 'No Tax on Tips and Overtime Calculators',
  description,
  app: false,
}).filter((item) => (item as { '@type'?: string })['@type'] !== 'BreadcrumbList');

const guides = [
  { href: '/schedule-1-a-guide/', title: 'Schedule 1-A, line by line (2026)', blurb: 'Every line of Parts I–III, with worked numbers and the IRS source for each step.' },
  { href: '/w2-box-12-code-tt/', title: 'W-2 box 12 code TT explained', blurb: 'The new overtime code, and what to do if it is missing or wrong.' },
];
---

<Base title={title} description={description} fullTitle locale="en" schema={schema}>
  <section class="section section--tight">
    <div class="page" style="max-width:52rem">
      <p class="eyebrow">Tax year 2026 · Free · Runs in your browser</p>
      <h1>No Tax on Tips and Overtime Calculators (2026)</h1>
      <p class="lede">
        For 2025 through 2028, workers can deduct up to $25,000 of qualified tips and up to $12,500 of qualified overtime
        ($25,000 married filing jointly) from federal taxable income. Both are claimed on Schedule 1-A and both work with
        the standard deduction. They are deductions, not tax-free pay: Social Security and Medicare still apply.
      </p>
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="tools-heading">
    <div class="page" style="max-width:52rem">
      <h2 id="tools-heading" class="visually-hidden">Calculators</h2>
      <div class="grid-2">
        <div class="card">
          <h3 style="margin-top:0">No tax on overtime calculator</h3>
          <p>
            Enter your W-2 box 12 code TT amount — or estimate it from your hourly rate and overtime hours — and see your
            deduction after the cap and phase-out, plus the federal tax it saves.
          </p>
          <a class="btn btn--primary btn--lg" href="/no-tax-on-overtime-calculator/">Calculate overtime deduction</a>
        </div>
        <div class="card">
          <h3 style="margin-top:0">No tax on tips calculator</h3>
          <p>
            For W-2 tipped workers (code TP and box 14b) and 1099 workers such as delivery and rideshare drivers. Applies
            the $25,000 cap, the net-profit limit and the phase-out.
          </p>
          <a class="btn btn--primary btn--lg" href="/no-tax-on-tips-calculator/">Calculate tips deduction</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="compare-heading">
    <div class="page" style="max-width:52rem">
      <h2 id="compare-heading">No tax on tips vs. no tax on overtime</h2>
      <div style="overflow-x:auto">
        <table>
          <thead>
            <tr><th></th><th>No tax on tips</th><th>No tax on overtime</th></tr>
          </thead>
          <tbody>
            <tr><th>What you deduct</th><td>Qualified tips, paid voluntarily by customers</td><td>The FLSA overtime premium — usually the “half” of time-and-a-half</td></tr>
            <tr><th>Maximum</th><td>$25,000 per return (joint returns too)</td><td>$12,500; $25,000 married filing jointly</td></tr>
            <tr><th>Phase-out (MAGI)</th><td colspan="2">−$100 for each full $1,000 over $150,000 ($300,000 joint)</td></tr>
            <tr><th>Who qualifies</th><td>Workers in an IRS-listed tipped occupation (W-2 or self-employed)</td><td>FLSA non-exempt workers paid FLSA overtime</td></tr>
            <tr><th>2026 W-2</th><td>Box 12 code TP, box 14b occupation code</td><td>Box 12 code TT</td></tr>
            <tr><th>Schedule 1-A</th><td>Part II</td><td>Part III</td></tr>
            <tr><th>Married filing separately</th><td colspan="2">Not allowed — you must file jointly</td></tr>
            <tr><th>Years</th><td colspan="2">Tax years 2025 through 2028</td></tr>
          </tbody>
        </table>
      </div>
      <div class="note note--warn" style="margin-top:1rem">
        <strong>Not tax-free pay.</strong> These deductions lower federal income tax only. Social Security and Medicare
        (or self-employment tax) are still due on tips and overtime, and whether your state follows depends on the state.
      </div>
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="claim-heading">
    <div class="page" style="max-width:52rem">
      <h2 id="claim-heading">How to claim them</h2>
      <ol>
        <li>Find your numbers: W-2 box 12 codes <a href="/w2-box-12-code-tt/">TT</a> and TP, box 14b, and any tips or overtime shown on Forms 1099.</li>
        <li>Run the <a href="/no-tax-on-overtime-calculator/">overtime</a> or <a href="/no-tax-on-tips-calculator/">tips</a> calculator to check the deduction and what it saves.</li>
        <li>Fill in <a href="/schedule-1-a-guide/">Schedule 1-A line by line</a> and carry the total to Form 1040.</li>
      </ol>
    </div>
  </section>

  <RelatedLinks heading="Guides" items={guides} />

  <Faq items={HUB_FAQ} heading="No tax on tips and overtime FAQ" />

  <TaxSources sources={[SRC.fs202503, SRC.s1a2026, SRC.i1040, SRC.fs202613, SRC.iw2, SRC.ttoc]} />
</Base>
