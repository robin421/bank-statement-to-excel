---
import Base from '../layouts/Base.astro';
import RelatedLinks from '../components/RelatedLinks.astro';

const related = [
  { href: '/', title: 'No tax on tips and overtime', blurb: 'Both calculators, side by side.' },
  { href: '/schedule-1-a-guide/', title: 'Schedule 1-A line by line', blurb: 'Where the numbers go on the form.' },
  { href: '/privacy/', title: 'Privacy', blurb: 'What is and is not collected.' },
  { href: '/contact/', title: 'Contact', blurb: 'Report an error or an outdated rule.' },
];
---

<Base
  title="About"
  description="WattFlow builds free, browser-based calculators for the 2025–2028 no tax on tips and no tax on overtime deductions, sourced from IRS forms and guidance."
>
  <section class="section">
    <div class="page prose">
      <p class="eyebrow">About</p>
      <h1>Tax calculators that show their sources</h1>
      <p class="lede">
        WattFlow makes free calculators and plain-English guides for the federal no tax on tips and no tax on overtime
        deductions that apply to tax years 2025 through 2028.
      </p>

      <h2>How the pages are written</h2>
      <p>
        Every rule on this site comes from an IRS form, its instructions, or IRS guidance, and every page lists the
        sources it used and the date it was last checked. Where the IRS has only published a draft — for example the 2026
        Schedule 1-A — the page says so. When the IRS changes something, we update the page and note it in the page’s
        changelog.
      </p>

      <h2>How the calculators work</h2>
      <p>
        The calculators run in your browser. There is no account, and the figures you type are not sent to us. They
        estimate federal income tax only: they apply the deduction caps and the income phase-out exactly as the form
        does, then compare your federal tax with and without the deduction using the published 2026 rate tables.
      </p>

      <h2>What we are not</h2>
      <p>
        We are not tax preparers, and no CPA or enrolled agent has reviewed these pages. Nothing here is tax advice.
        WattFlow is independent and is not affiliated with the IRS, the U.S. Treasury or any tax software company.
      </p>

      <h2>How it is funded</h2>
      <p>
        Advertising, and a link to our own Shift Work Calendar app on the overtime pages. The calculators are free and
        not gated behind anything.
      </p>
    </div>
  </section>

  <RelatedLinks heading="Elsewhere" items={related} />
</Base>
