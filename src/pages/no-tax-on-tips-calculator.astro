---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import AdSlot from '../components/AdSlot.astro';
import TaxCalculator from '../components/tax/TaxCalculator.astro';
import TaxSources from '../components/tax/TaxSources.astro';
import { TIP_FAQ, SRC } from '../lib/tax/content';
import { taxPageSchema } from '../lib/tax/schema';
import { SITE } from '../data/site.mjs';

const title = 'No Tax on Tips Calculator 2026 — W-2, 1099 & DoorDash | WattFlow';
const description =
  'Estimate your 2026 tip deduction: up to $25,000 of qualified tips, phase-out above $150k/$300k MAGI, W-2 code TP and 1099/1099-K tips. Free, runs in your browser.';
const schema = taxPageSchema({ origin: Astro.site?.href ?? SITE.url, path: '/no-tax-on-tips-calculator/', name: 'No Tax on Tips Calculator', description, app: true });
const related = [
  { href: '/no-tax-on-overtime-calculator/', title: 'No tax on overtime calculator', blurb: 'The FLSA overtime premium, up to $12,500 ($25,000 joint).' },
  { href: '/w2-box-12-code-tt/', title: 'W-2 box 12 code TT explained', blurb: 'The overtime code on 2026 W-2s.' },
  { href: '/schedule-1-a-guide/', title: 'Schedule 1-A line by line', blurb: 'Where your tips go in Part II of the 2026 form.' },
];
---

<Base title={title} description={description} fullTitle locale="en" schema={schema}>
  <section class="section section--tight">
    <div class="page" style="max-width:48rem">
      <p class="eyebrow">Tax year 2026 · Runs in your browser · Nothing uploaded</p>
      <h1>No Tax on Tips Calculator (2026 and 2025)</h1>
      <p class="lede">
        If you work in an IRS-listed tipped occupation, you can deduct up to $25,000 of qualified tips a year for
        2025–2028, reduced above $150,000 MAGI ($300,000 joint). Tips are still subject to Social Security and Medicare.
      </p>
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="how-heading">
    <div class="page" style="max-width:48rem">
      <h2 id="how-heading">How no tax on tips works</h2>
      <p>
        Employees and self-employed workers can both claim it, on Schedule 1-A, Part II, with or without itemizing. The
        $25,000 cap is per return — it isn’t doubled on a joint return. Married couples must file jointly, and the person
        who received the tips needs a Social Security number valid for employment.
      </p>
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="calc-heading">
    <div class="page" style="max-width:48rem">
      <h2 id="calc-heading">Calculator</h2>
      <TaxCalculator kind="tips" />
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="occ-heading">
    <div class="page" style="max-width:48rem">
      <h2 id="occ-heading">Is my job on the IRS tipped occupations list?</h2>
      <p>
        Only tips earned in an occupation on the IRS list count. The list has more than 70 occupations, each with a
        three-digit Treasury Tipped Occupation Code, in 8 groups: 100s beverage and food service, 200s entertainment and
        events, 300s hospitality and guest services, 400s home services, 500s personal services, 600s personal appearance
        and wellness, 700s recreation and instruction, and 800s transportation and delivery. The final rules added visual
        artists, floral designers and gas pump attendants. The calculator’s occupation menu is copied from the{' '}
        <a href="https://www.irs.gov/forms-pubs/occupations-that-customarily-and-regularly-received-tips-on-or-before-dec-31-2024" rel="noopener" target="_blank">IRS list</a>.
      </p>
      <p class="small muted">
        Tips earned in a specified service trade or business (SSTB) are excluded by law, including when your employer is
        an SSTB. The details are set by the IRS — check its guidance; this calculator doesn’t test for it.
      </p>
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="what-heading">
    <div class="page" style="max-width:48rem">
      <h2 id="what-heading">What counts as a qualified tip</h2>
      <ul>
        <li>Paid voluntarily by the customer, not negotiated, and with the amount decided by the customer.</li>
        <li>Paid in cash or an equivalent: check, credit or debit card, gift card, or a payment app.</li>
        <li>Received from customers or, for employees, through a tip-sharing arrangement such as a tip pool.</li>
        <li>Not a mandatory service charge — unless the customer can remove or change it.</li>
      </ul>
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="w2-heading">
    <div class="page" style="max-width:48rem">
      <h2 id="w2-heading">W-2 employees: box 12 code TP and box 14b</h2>
      <p>
        On 2026 Forms W-2, box 12 code TP shows the total cash tips you reported to your employer, and box 14b shows up
        to two Treasury Tipped Occupation Codes. If box 14b shows only 000, the tips in code TP aren’t qualified tips.
      </p>
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="gig-heading">
    <div class="page" style="max-width:48rem">
      <h2 id="gig-heading">1099, DoorDash, Uber and other gig workers</h2>
      <p>
        If you’re self-employed in a listed occupation — the list includes taxi and rideshare drivers and goods delivery
        people — use the qualified tips included in your Forms 1099. For 2025 they sit inside 1099-NEC box 1, 1099-MISC
        box 3 or 1099-K box 1a; the IRS 2026 drafts add separate cash-tip boxes (1099-NEC box 1b, 1099-MISC box 13a,
        1099-K box 1c). The deduction can’t be more than the net profit of the business you earned the tips in.
      </p>
    </div>
  </section>

  <AdSlot adSlot="tax-tips-mid" />

  <section class="section section--tight" aria-labelledby="limits-heading">
    <div class="page" style="max-width:48rem">
      <h2 id="limits-heading">Limits and phase-out</h2>
      <p>
        Up to $25,000 per return. Above $150,000 MAGI ($300,000 joint) the deduction drops by $100 for every full $1,000
        over — subtract the threshold, divide by 1,000, round down. A full $25,000 deduction is gone at $400,000 MAGI
        (single) or $550,000 (joint).
      </p>
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="ex-heading">
    <div class="page" style="max-width:48rem">
      <h2 id="ex-heading">Worked examples</h2>
      <ol>
        <li><strong>W-2 server (code 102).</strong> Wages $38,000 including code TP $18,000. Single, AGI $38,000. Taxable income falls from $21,900 to $3,900, and tax from $2,380 to $390 — <strong>$1,990</strong> saved. (10% × $12,400 = $1,240, plus 12% × $9,500 = $1,140.)</li>
        <li><strong>Delivery driver on a 1099-K.</strong> Tips $6,000, net profit of the delivery business $4,500. The deduction is capped at net profit: <strong>$4,500</strong>.</li>
        <li><strong>High income.</strong> Single, MAGI $162,500, qualified tips $30,000. Capped at $25,000; $12,500 over → 12.5 → rounded down to 12 → $1,200 off → <strong>$23,800</strong>.</li>
        <li><strong>Automatic service charge.</strong> A restaurant adds 18% to large parties and the customer can’t remove it. That money is <strong>not</strong> a qualified tip, even if it’s paid out to staff.</li>
      </ol>
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="claim-heading">
    <div class="page" style="max-width:48rem">
      <h2 id="claim-heading">How to claim it on Schedule 1-A (Part II)</h2>
      <p>
        Enter your qualified employee tips and qualified self-employed tips in Part II of Schedule 1-A, apply the $25,000
        cap and the MAGI reduction, and attach Schedule 1-A to Form 1040, 1040-SR or 1040-NR.
      </p>
      <p>
        Step by step, with the 2026 line numbers: <a href="/schedule-1-a-guide/">Schedule 1-A line-by-line guide</a>.
      </p>
      <h3>Methodology</h3>
      <p class="small">
        Qualified tips = W-2 code TP + min(1099 tips, net profit), only when an IRS occupation code is chosen.
        Deduction = max(0, min(qualified tips, $25,000) − floor(max(0, MAGI − threshold) / 1,000) × $100). Tax saved is
        2026 federal tax before minus after, using Rev. Proc. 2025-32 rate tables and standard deduction; MAGI is used as
        AGI; credits are ignored; no 2025 estimate is shown. Every calculation happens in your browser.
      </p>
    </div>
  </section>

  <Faq items={TIP_FAQ} heading="No tax on tips FAQ" />

  <RelatedLinks heading="Related" items={related} />

  <TaxSources sources={[SRC.fs202503, SRC.s1a, SRC.s1a2026, SRC.f1099necDft, SRC.f1099miscDft, SRC.f1099kDft, SRC.finalRegs, SRC.ttoc, SRC.n2569, SRC.iw2, SRC.fw2, SRC.rp2532]} />
</Base>
