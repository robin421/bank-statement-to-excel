{
  "name": "bankto",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/strip-appledouble.mjs dist",
    "preview": "astro preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:links": "node scripts/check-links.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && vitest run && npm run build && npm run check:links",
    "fixtures": "node fixtures/generate.mjs",
    "verify:bank": "vite-node scripts/verify-bank.mjs --",
    "inspect:statement": "vite-node scripts/inspect-statement.ts --",
    "verify:real": "vite-node scripts/record-real-baseline.mjs",
    "seq:money": "vite-node scripts/seq-money.ts --",
    "decode2": "vite-node scripts/decode2.ts --",
    "corpus:dump": "node scripts/corpus-inspect.mjs --"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.5",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vitest": "^5.0.0",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright": "^1.58.0",
    "read-excel-file": "^6.0.3",
    "typescript": "^7.0.2",
    "vite-node": "^6.0.0"
  }
}
