    "vitest": "^5.0.0",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright": "^1.58.0",
    "read-excel-file": "^6.0.3",
    "typescript": "^7.0.2"
  }
